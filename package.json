{
  "name": "pokebot",
  "version": "1.0.0",
  "description": "Discord bot about Pokemon",
  "main": "src",
  "scripts": {
    "start": "NODE_ENV=production node .",
    "start:dev": "NODE_ENV=development node .",
    "start:test": "NODE_ENV=test node .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:rebuild": "docker compose up -d --build",
    "docker:restart": "docker compose restart",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:rebuild": "docker compose -f docker-compose.test.yml up -d --build",
    "docker:test:restart": "docker compose -f docker-compose.test.yml restart pokebot_test",
    "docker:logs": "docker compose logs -f",
    "docker:test:logs": "docker compose -f docker-compose.test.yml logs -f",
    "deploy-commands": "node src/deploy-commands.js",
    "deploy-commands:dev": "NODE_ENV=development node src/deploy-commands.js",
    "deploy-commands:test": "NODE_ENV=test node src/deploy-commands.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "clezred",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "canvas": "^3.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "latinize": "^2.0.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clezred/pokebot.git"
  },
  "bugs": {
    "url": "https://github.com/clezred/pokebot/issues"
  },
  "homepage": "https://github.com/clezred/pokebot#readme"
}
